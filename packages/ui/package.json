{
  "name": "ui",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "build": "tsc && build-storybook",
    "build-and-run": "tsc && build-storybook && open http://127.0.0.1:8080 && pnpm dlx http-server ./storybook-static",
    "dev": "start-storybook -p 6006",
